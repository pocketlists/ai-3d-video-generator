# ===============================================
# Required GitHub Secrets / Environment Variables
# ===============================================
# Copy this file, fill in your values, and add them as GitHub Secrets.
# NEVER commit actual secrets to the repository.

# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here

# --- AI API (OPTIONAL — for AI planning) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- TTS (OPTIONAL — for high-quality voice) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- HuggingFace (OPTIONAL — for model access) ---
HF_TOKEN=your_huggingface_token_here

# --- Replicate (OPTIONAL — for AI asset generation) ---
REPLICATE_API_TOKEN=your_replicate_token_here

# --- Blender (OPTIONAL — if using custom Blender build) ---
BLENDER_PATH=blender
