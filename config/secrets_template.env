# ===============================================
# Required GitHub Secrets / Environment Variables
# ===============================================
# Copy this file, fill in your values, and add them as GitHub Secrets.
# NEVER commit actual secrets to the repository.

# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Gemini API (OPTIONAL — for AI planning) ---
GEMINI_API_KEY=

# --- 3D Asset API (OPTIONAL — for real 3D models) ---
THREE_D_ASSET_API_KEY=
THREE_D_ASSET_API_URL=

# --- OpenAI API (OPTIONAL — alternative LLM) ---
OPENAI_API_KEY=

# --- ElevenLabs (OPTIONAL — high-quality TTS) ---
ELEVENLABS_API_KEY=

# --- HuggingFace (OPTIONAL — model access) ---
HF_TOKEN=

# --- Replicate (OPTIONAL — AI asset generation) ---
REPLICATE_API_TOKEN=

# --- Blender (OPTIONAL — custom Blender path) ---
BLENDER_PATH=blender

# --- TTS Configuration ---
TTS_PROVIDER=google
TTS_MODE=free

# --- LLM Configuration ---
LLM_PROVIDER=template
