# ===============================================
# Required GitHub Secrets / Environment Variables
# ===============================================
# Copy this file, fill in values, and add as GitHub Secrets.
# NEVER commit actual secrets to the repository.

# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID is OPTIONAL — if left empty, the bot auto-detects it
# from the first message you send it (or first channel post where it is admin).
TELEGRAM_CHANNEL_ID=
TELEGRAM_ALLOWED_USER_IDS=

# --- Gemini API (planning + Gemini TTS — same key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI API (OPTIONAL — alternative LLM) ---
OPENAI_API_KEY=

# --- 3D Asset API (OPTIONAL) ---
THREE_D_ASSET_API_KEY=
THREE_D_ASSET_API_URL=

# --- ElevenLabs (OPTIONAL — high-quality TTS) ---
ELEVENLABS_API_KEY=

# --- HuggingFace (OPTIONAL — Objaverse access) ---
HF_TOKEN=

# --- Replicate (OPTIONAL) ---
REPLICATE_API_TOKEN=

# --- Google Cloud TTS (OPTIONAL — production voices) ---
GOOGLE_APPLICATION_CREDENTIALS=

# --- Blender ---
BLENDER_PATH=blender

# --- Gemini TTS Configuration ---
# Models: gemini-2.5-flash-preview-tts | gemini-2.5-pro-preview-tts | gemini-3.1-flash-tts-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 30 prebuilt voices: Kore, Puck, Zephyr, Aoede, Fenrir, ...
GEMINI_TTS_VOICE=Kore

# --- TTS Configuration ---
TTS_PROVIDER=gemini_tts
TTS_MODE=free
GOOGLE_TTS_LANGUAGE=en

# --- LLM Configuration ---
LLM_PROVIDER=template
ALLOW_TEMPLATE_FALLBACK=false

# --- Asset Configuration ---
ASSET_PROVIDER=objaverse
OBJAVERSE_ENABLED=false

# --- Render Configuration ---
MAX_RENDER_WORKERS=20
DEFAULT_RENDER_WORKERS=4
MIN_QUALITY_SCORE=85

# --- State Backend ---
STATE_BACKEND=local

# --- Pipeline Mode (production | test) ---
PIPELINE_MODE=production
